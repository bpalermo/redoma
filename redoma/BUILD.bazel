load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "redoma_lib",
    srcs = ["main.go"],
    importpath = "github.com/bpalermo/redoma/redoma",
    visibility = ["//visibility:private"],
    deps = [
        "//common/config",
        "//common/version",
        "//msg",
        "//ocihook",
        "//relay",
        "//xds",
        "@com_github_spf13_cobra//:cobra",
    ],
)

go_binary(
    name = "redoma",
    embed = [":redoma_lib"],
    # Pure Go: one static binary, cross-built for every platform.
    pure = "on",
    visibility = ["//visibility:public"],
)

go_test(
    name = "redoma_test",
    srcs = ["main_test.go"],
    data = ["redoma.conf"],
    embed = [":redoma_lib"],
    deps = [
        "//common/config",
        "//common/version",
    ],
)

# The settings file the package installs as its conffile.
exports_files(["redoma.conf"])
