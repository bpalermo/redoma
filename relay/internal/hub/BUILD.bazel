        "hub.go",
        "inbound.go",
        "limits.go",
        "services.go",
        "store.go",
        "watch.go",
    ],
    importpath = "github.com/bpalermo/redoma/relay/internal/hub",
    visibility = ["//relay:__subpackages__"],
