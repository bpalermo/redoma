# redoma-mcp@<name>: a host MCP upstream's server (docs/mcp-upstreams.md), the
# container its /etc/redoma/mcp/<name>.conf describes, run by Podman in the
# foreground: --network none, --userns=auto, no capability, a read-only
# root, its credential's directory (token_file) mounted read-only. The OCI
# hook checks the container and, once its namespace has nothing but lo,
# registers it with redoma xds, which publishes its egress listener and its
# cluster. One instance serves every agent whose allowlist names it. The
# server runs as its user namespace's root (an unprivileged host uid).
#
# Installed by the redoma package in /usr/lib/systemd/system. Start one with
# `systemctl enable --now redoma-mcp@<name>`. Every start first runs
# redoma-mcp-token@<name>.service, which copies the credential: /run is a
# tmpfs, so after a boot the copy exists only once that has run, and its
# path unit fires only on a change. While the minter has written nothing,
# the start fails on the missing credential and is retried every 5 seconds,
# with no start limit, so it never stays failed; the minter's first write
# makes the copy (redoma-mcp-token@<name>.path) the next start finds.
#
# podman run stays in the foreground. If the podman client dies, the
# container (under conmon) may outlive it: the restart's run --replace
# removes that container before it starts the new one.
[Unit]
Description=redoma MCP upstream %i
Documentation=https://github.com/bpalermo/redoma/blob/main/docs/mcp-upstreams.md
Wants=redoma-xds.service redoma-mcp-token@%i.service
After=redoma-xds.service redoma-mcp-token@%i.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/redoma mcp-upstream run %i
ExecStop=/usr/bin/podman stop --ignore --time 10 redoma-mcp-%i
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
