load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "identity",
    srcs = [
        "broker.go",
        "identity.go",
        "workload.go",
    ],
    importpath = "github.com/bpalermo/redoma/xds/internal/identity",
    visibility = ["//xds:__subpackages__"],
    deps = [
        "//xds/internal/agent",
        "@com_github_spiffe_go_spiffe_v2//bundle/x509bundle",
        "@com_github_spiffe_go_spiffe_v2//exp/proto/spiffe/broker",
        "@com_github_spiffe_go_spiffe_v2//spiffegrpc/grpccredentials",
        "@com_github_spiffe_go_spiffe_v2//spiffeid",
        "@com_github_spiffe_go_spiffe_v2//spiffetls/tlsconfig",
        "@com_github_spiffe_go_spiffe_v2//svid/jwtsvid",
        "@com_github_spiffe_go_spiffe_v2//svid/x509svid",
        "@com_github_spiffe_go_spiffe_v2//workloadapi",
        "@com_github_spiffe_spire_api_sdk//proto/spire/api/agent/delegatedidentity/v1:delegatedidentity",
        "@com_github_spiffe_spire_api_sdk//proto/spire/api/types",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_grpc//metadata",
        "@org_golang_google_protobuf//types/known/anypb",
    ],
)

go_test(
