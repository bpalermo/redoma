        "//examples:envoy.yaml",
    ],
    embed = [":lds"],
    deps = [
        "//xds/internal/egress",
        "//xds/internal/modelauth",
        "@com_github_envoyproxy_go_control_plane_envoy//config/bootstrap/v3:bootstrap",
        "@com_github_envoyproxy_go_control_plane_envoy//config/cluster/v3:cluster",
        "@com_github_envoyproxy_go_control_plane_envoy//config/listener/v3:listener",
        "@com_github_envoyproxy_go_control_plane_envoy//extensions/clusters/dynamic_forward_proxy/v3:dynamic_forward_proxy",
        "@com_github_envoyproxy_go_control_plane_envoy//extensions/filters/http/dynamic_forward_proxy/v3:dynamic_forward_proxy",
