load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "xds",
    srcs = [
        "command.go",
        "upstream.go",
    ],
    importpath = "github.com/bpalermo/redoma/xds",
    visibility = ["//visibility:public"],
    deps = [
        "//common/config",
        "//common/forbidden",
        "//common/version",
        "//xds/internal/activedir",
        "//xds/internal/agent",
        "//xds/internal/awscreds",
        "//xds/internal/cds",
        "//xds/internal/controlplane",
        "//xds/internal/fdstore",
        "//xds/internal/hooksource",
        "//xds/internal/hostcheck",
        "//xds/internal/identity",
        "//xds/internal/lds",
        "//xds/internal/mcpconf",
        "//xds/internal/rolesanywhere",
        "//xds/internal/server",
        "//xds/internal/upstreamrun",
        "@com_github_envoyproxy_go_control_plane//pkg/cache/v3:cache",
        "@com_github_spf13_cobra//:cobra",
        "@com_github_spiffe_go_spiffe_v2//spiffeid",
    ],
)

# The units `redoma xds` and `redoma mcp-upstream` are installed with.
exports_files([
    "redoma-mcp-token@.path",
    "redoma-mcp-token@.service",
    "redoma-mcp@.service",
    "redoma-xds.service",
])

go_test(
    name = "xds_test",
    srcs = [
        "command_test.go",
        "upstream_test.go",
    ],
    data = [
        "redoma-mcp-token@.path",
        "redoma-mcp-token@.service",
        "redoma-mcp@.service",
    ],
    embed = [":xds"],
    deps = [
        "//common/config",
        "//xds/internal/hostcheck",
        "//xds/internal/lds",
        "//xds/internal/mcpconf",
        "//xds/internal/upstreamrun",
    ],
)
