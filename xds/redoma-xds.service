# redoma-xds: the host Envoy's control plane for the agent containers. Serves
# the listeners of every running agent (LDS), their relay and AWS
# credentials clusters and the tunnels to IAM Roles Anywhere (CDS), and each
# agent's SPIFFE identity (SDS) over ADS on /run/redoma/xds/xds.sock,
# fetching the identities from SPIRE: the Delegated Identity API on the SPIRE
# agent's admin socket, or the SPIFFE Broker API (identity_api and the
# spire_* sockets in /etc/redoma/redoma.conf).
#
# Installed by the redoma package in /usr/lib/systemd/system. SPIRE's sockets
# are redialled with backoff until they are there, so the unit has no
# dependency on the SPIRE agent's own unit; order them with a drop-in if you
# want the first redials saved.
[Unit]
Description=redoma xds: LDS, CDS and SDS for the agent containers' host Envoy
Documentation=https://github.com/bpalermo/redoma

[Service]
Type=simple
ExecStart=/usr/bin/redoma xds
Restart=always
RestartSec=2

# uid 961 is the one identity SPIRE must let use the admin socket (the
# agent's authorized_delegates, its entry selected by unix:uid:961). The
# package makes the user (sysusers.d).
User=redoma-sds
Group=redoma-sds

# /run/redoma/xds, 0750 redoma-sds: the socket's directory. Kept across
# restarts: a containerized Envoy bind-mounts the directory, and one
# recreated would leave the container looking at the deleted one. systemd
# makes the parent, /run/redoma, root 0755 when it is missing, and owns and
# removes only the innermost directory, so the units sharing /run/redoma
# never touch each other's.
RuntimeDirectory=redoma/xds
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes

# The pidfd of each hook-registered agent's process, which the Broker API
# names the agent by, is kept in systemd's file descriptor store under its
# container's ID, so a restart of the service gets it back. Preserve keeps
# the store across a stop and a start too (systemd 254 and later; older ones
# ignore the setting, and keep the store across a restart but not a stop and
# a start). An agent whose pidfd was lost gets no SVID in Broker mode until
# its container is restarted.
NotifyAccess=main
FileDescriptorStoreMax=1024
FileDescriptorStorePreserve=yes

# The socket is 0660 once bound (server.SocketMode); owner-only before that.
UMask=0077

# It reads /etc/redoma, /run/redoma/active and /run/netns (and in Broker
# mode /etc/passwd and /etc/group, to check who may reach the Workload API),
# and the system's CA certificates; connects to SPIRE's unix sockets and to
# the tunnels the host Envoy serves in /run/redoma/xds/tunnel; and listens
# on its own sockets, the agents' AWS credentials ones in
# /run/redoma/xds/aws among them; nothing else.
# Connecting to a socket needs no write access to its file system, so the
# read-only system is no obstacle to SPIRE's sockets. It reads no other
# process's /proc: an agent's PID comes from the pidfd's fdinfo, its own.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
# Unix sockets are file system objects and reach across network namespaces;
# this one has no network at all. It reaches IAM Roles Anywhere only through
# the host Envoy's tunnels, unix sockets, with TLS of its own end to end.
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
