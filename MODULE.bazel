module(
    name = "redoma",
    version = "0.0.0",
)

bazel_dep(name = "rules_go", version = "0.64.2")
bazel_dep(name = "gazelle", version = "0.54.0")

# proto_library for //api, compiled by rules_go's go_proto and go_grpc_v2
# (protoc-gen-go-grpc is a tool in go.mod). The version the graph already
# resolves to through rules_go.
bazel_dep(name = "protobuf", version = "33.4")
bazel_dep(name = "platforms", version = "1.1.0")

# The runtime image (//runtime), built with no Containerfile.
bazel_dep(name = "rules_img", version = "0.3.23")

# build_test for //:binaries_test, and already in the graph through rules_go;
# declared so a bump of it cannot drop it.
bazel_dep(name = "bazel_skylib", version = "1.9.2")

# pkg_deb for //deb, the Debian package of the host side.
bazel_dep(name = "rules_pkg", version = "1.3.0")

# sh_library and sh_test for the scripts under //bazel.
bazel_dep(name = "rules_shell", version = "0.8.0")

# Formatting and the linters that are not part of compiling: //bazel/format
# formats and checks Starlark (buildifier, with its lint warnings), Go and
# shell; //bazel/lint has the shellcheck and gocognit aspects.
bazel_dep(name = "aspect_rules_lint", version = "2.9.1")
bazel_dep(name = "buildifier_prebuilt", version = "10.1.0")

# Prebuilt tools pinned by URL and sha256 in multitool.lock.json, run through
# Bazel so CI and a developer machine run the same binary: bazel-diff, which
# bazel/ci-impacted-targets.sh builds as @multitool//tools/bazel-diff.
# Dependabot does not update these pins: bump the version and the sha256s
# (GitHub's asset digests) together, by hand.
bazel_dep(name = "rules_multitool", version = "1.11.1")

multitool = use_extension("@rules_multitool//multitool:extension.bzl", "multitool")
multitool.hub(lockfile = "//:multitool.lock.json")
use_repo(multitool, "multitool")

# The Go toolchain, the version of go.mod's `go` line.
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//:go.mod")

# Static analysis, run as part of compiling every Go package of this module
# (and of none of its dependencies): a finding fails the build. //:nogo says
# which analyzers.
go_sdk.nogo(nogo = "//:nogo")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# The SPIRE API SDK commits its generated Go beside the .proto sources, and
# its .protos import each other by paths Gazelle cannot resolve, so its BUILD
# files are generated with proto generation off: the .pb.go is the library.
go_deps.gazelle_override(
    build_file_generation = "clean",
    directives = ["gazelle:proto disable_global"],
    path = "github.com/spiffe/spire-api-sdk",
)
use_repo(go_deps, "co_honnef_go_tools", "com_github_envoyproxy_go_control_plane", "com_github_envoyproxy_go_control_plane_envoy", "com_github_google_go_cmp", "com_github_spf13_cobra", "com_github_spiffe_go_spiffe_v2", "com_github_spiffe_spire_api_sdk", "com_github_uudashr_gocognit", "in_gopkg_yaml_v3", "org_golang_google_grpc", "org_golang_google_grpc_cmd_protoc_gen_go_grpc", "org_golang_google_protobuf", "org_golang_x_sys")

# The runtime image's Debian packages (//runtime): bookworm, for amd64 and
# arm64, from snapshot.debian.org at one instant, so a resolution never
# moves; every .deb is pinned by its sha256 from that snapshot's index. The packages and
# their whole dependency closure are resolved by rules_distroless; Bazel
# records what it resolved in MODULE.bazel.lock (the extension's facts), so
# a build fetches only those .debs. To move to newer packages, change the
# snapshot (all three lines) and run `bazel mod tidy`.
bazel_dep(name = "rules_distroless", version = "0.9.4")

apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.sources_list(
    architectures = [
        "amd64",
        "arm64",
    ],
    components = ["main"],
    suites = [
        "bookworm",
        "bookworm-updates",
    ],
    types = ["deb"],
    uris = ["https://snapshot.debian.org/archive/debian/20261020T000000Z"],
)
apt.sources_list(
    architectures = [
        "amd64",
        "arm64",
    ],
    components = ["main"],
    suites = ["bookworm-security"],
    types = ["deb"],
    uris = ["https://snapshot.debian.org/archive/debian-security/20261020T000000Z"],
)
apt.install(
    dependency_set = "bookworm",
    packages = [
        # What agents use.
        "ca-certificates",
        "git",
        "jq",
        "python3",
        "ripgrep",
        # A shell and the tools any script expects: Claude Code's Bash tool
        # runs commands under bash, and git and hooks call sh.
        "base-files",
        "bash",
        "coreutils",
        "dash",
        "diffutils",
        "findutils",
        "grep",
        "gzip",
        "procps",
        "sed",
        "tar",
        # Their dependencies, every one, as resolved: rules_distroless writes
        # /var/lib/dpkg/status from the packages listed here only, and
        # scanners read that file to know what the image holds.
        # //runtime:dpkg_status_test fails, naming it, on an installed
        # package missing here (a snapshot that adds a dependency) and on
        # one listed here that is not installed.
        "debconf",
        "debianutils",
        "dpkg",
        "gcc-12-base",
        "git-man",
        "init-system-helpers",
        "libacl1",
        "libattr1",
        "libbrotli1",
        "libbz2-1.0",
        "libc6",
        "libcap2",
        "libcom-err2",
        "libcrypt1",
        "libcurl3-gnutls",
        "libdb5.3",
        "libelogind0",
        "liberror-perl",
        "libexpat1",
        "libffi8",
        "libfile-find-rule-perl",
        "libgcc-s1",
        "libgdbm-compat4",
        "libgdbm6",
        "libgmp10",
        "libgnutls30",
        "libgssapi-krb5-2",
        "libhogweed6",
        "libidn2-0",
        "libjq1",
        "libk5crypto3",
        "libkeyutils1",
        "libkrb5-3",
        "libkrb5support0",
        "libldap-2.5-0",
        "liblzma5",
        "libmd0",
        "libncursesw6",
        "libnettle8",
        "libnghttp2-14",
        "libnsl2",
        "libnumber-compare-perl",
        "libonig5",
        "libp11-kit0",
        "libpcre2-8-0",
        "libperl5.36",
        "libproc2-0",
        "libpsl5",
        "libpython3-stdlib",
        "libpython3.11-minimal",
        "libpython3.11-stdlib",
        "libreadline8",
        "librtmp1",
        "libsasl2-2",
        "libsasl2-modules-db",
        "libselinux1",
        "libsqlite3-0",
        "libssh2-1",
        "libssl3",
        "libtasn1-6",
        "libtext-glob-perl",
        "libtinfo6",
        "libtirpc-common",
        "libtirpc3",
        "libunistring2",
        "libuuid1",
        "libzstd1",
        "mawk",
        "media-types",
        "openssl",
        "perl",
        "perl-base",
        "perl-modules-5.36",
        "python3-minimal",
        "python3.11",
        "python3.11-minimal",
        "readline-common",
        "usrmerge",
        "zlib1g",
    ],
    suites = [
        "bookworm",
        "bookworm-security",
        "bookworm-updates",
    ],
)
use_repo(apt, "bookworm")

# Claude Code in the runtime image (//runtime): the native binaries of the npm
# packages @anthropic-ai/claude-code-linux-x64 and -linux-arm64, unmodified,
# each pinned by the sha256 of its tarball. To bump it, change the version
# and both hashes (each tarball's `sha256sum`; npm publishes its sha512 as
# dist.integrity). //runtime:claude_code_test checks that each tarball is
# that version and that architecture.
claude_code = use_repo_rule("//bazel/claude_code:repo.bzl", "claude_code")

claude_code(
    name = "claude_code",
    sha256 = {
        "arm64": "3aa8e624d35e8a77a851e7009b83ae95d3168f24f1afdb0a1ed580a2313d9e5c",
        "x64": "f1c3d923ff3ac7e7080b8b9c638833dde72feab15e46940a65a0122d728c6bfd",
    },
    version = "2.1.312",
)
