common --enable_platform_specific_config
build --incompatible_strict_action_env

# Image tags and the binaries' version carry the git commit; this is where it
# comes from. The script never fails, so it cannot break a build.
build --workspace_status_command=bazel/workspace_status.sh

# Stamp by default, so that a binary built anywhere says which commit or
# release it is: the binaries' version (//common/version) comes from the
# workspace status. Every binary links again on each commit; nothing else
# rebuilds.
build --stamp

# protoc for //api: protobuf's prebuilt binary for the exec platform, not
# protoc compiled from source with the C++ toolchain (minutes on a cold
# cache, for every output base).
common --@protobuf//bazel/toolchains:prefer_prebuilt_protoc
# A protoc compiled from source anyway (toolchain resolution falling back
# to it, or a target naming @protobuf//:protoc, which is always the
# source-built one) fails loudly instead of slowly: this copt breaks the
# compile of protoc's main.cc. --per_file_copt matches source paths, so it
# names that file; a regex on protoc's output path would never fire.
common --per_file_copt=external/protobuf[^/]*/src/google/protobuf/compiler/main\.cc@--THIS_CC_TOOLCHAIN_IS_BROKEN

test --test_output=errors
# GitHub Actions sets CI; the tests that skip where unix sockets are refused
# fail instead when it is set (identitytest.SkipIfRefused).
test:ci --test_env=CI

# rules_lint reports its use to Aspect unless told not to.
common --repo_env=ASPECT_TOOLS_TELEMETRY=-all

# The linters that run as aspects (bazel/lint/linters.bzl). Alone,
# `--config=lint` only reports; with fail_on_violation, as in CI, a finding
# fails the build.
build:lint --aspects=//bazel/lint:linters.bzl%shellcheck,//bazel/lint:linters.bzl%gocognit

# CI: the lockfile must already be up to date, and a lint finding fails.
common:ci --lockfile_mode=error
build:ci --config=lint
build:ci --@aspect_rules_lint//lint:fail_on_violation

try-import %workspace%/user.bazelrc
